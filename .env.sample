# ==========================================
# KRX API 인증 (pykrx 로그인 필수)
# ==========================================
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# ==========================================
# 백테스트 기본 환경 변수 설정 (.env)
# ==========================================
# 테스트 기간
BACKTEST_START_DATE=2008-01-01
#BACKTEST_END_DATE= (미설정 시 마지막 영업일 자동 선택)

# 초기 투자금 (원 단위)
INITIAL_CAPITAL=100000000

# 거래 비용 비율 (예: 0.015% -> 0.00015)
BUY_COST=0.00015
SELL_COST=0.0023
SLIPPAGE=0.002

# 유니버스 및 전략 파라미터
N_STOCKS=30
PER_MIN=0.01
PER_MAX=4.00
MIN_MARKET_CAP=50000000000
MIN_TRADING_VAL=1000000000

# 멀티팩터 스코어링 (저PER+저PBR+고ROE+고배당)
USE_MULTI_FACTOR=true
PBR_MAX=1.5
ROE_MIN=0.05

# 부분 리밸런싱 (1.0 = 풀턴오버, 0.5 = 50%만 교체)
MAX_TURNOVER=0.5
