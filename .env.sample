# ==========================================
# KRX API 인증 (pykrx 로그인 필수)
# ==========================================
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# ==========================================
# [A] 공통 설정
# ==========================================
BACKTEST_START_DATE=2008-01-01
#BACKTEST_END_DATE=
INITIAL_CAPITAL=100000000
N_STOCKS=30
MIN_MARKET_CAP=50000000000
MIN_TRADING_VAL=1000000000
MAX_TURNOVER=0.5
REBALANCE_FREQ=monthly

BUY_COST=0.00015
SELL_COST=0.0023
SLIPPAGE=0.002

# ==========================================
# [B] 전략 선택
# ==========================================

# ── 전략 1: PER + 멀티팩터 가치투자 ──
#PER_MIN=0.01
#PER_MAX=4.00
#USE_MULTI_FACTOR=true
#PBR_MAX=1.5
#ROE_MIN=0.05
#USE_MOMENTUM=false
#USE_LOW_VOLATILITY=false

# ── 전략 2: 모멘텀 + 저변동성 (bias-free) ⭐ ──
PER_MIN=0.01
PER_MAX=99.0
USE_MULTI_FACTOR=false
USE_MOMENTUM=true
MOMENTUM_WINDOW=12
USE_LOW_VOLATILITY=true
