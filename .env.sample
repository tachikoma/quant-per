# ==========================================
# KRX API 인증 (pykrx 로그인 필수)
# ==========================================
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# ==========================================
# DART API 인증 (카스넬슨 가치투자 전용)
# https://opendart.fss.go.kr 에서 발급
# ==========================================
DART_API_KEY=your_dart_api_key

# ==========================================
# [A] 공통 설정
# ==========================================
BACKTEST_START_DATE=2008-01-01
#BACKTEST_END_DATE=
INITIAL_CAPITAL=100000000
N_STOCKS=30
MIN_MARKET_CAP=20000000000
MIN_TRADING_VAL=1000000000
MAX_TURNOVER=0.5
REBALANCE_FREQ=monthly

BUY_COST=0.00015
SELL_COST=0.0023
SLIPPAGE=0.002

# ==========================================
# [B] 전략 선택 (블록 주석 전환)
# ==========================================

# ── 전략 1: PBR + 멀티팩터 가치투자 ──
PBR_PCTILE=0.3
USE_MULTI_FACTOR=true
USE_MOMENTUM=false
USE_LOW_VOLATILITY=false
EXCLUDE_NEGATIVE_PER=true   # 음수 PER(적자기업) 제외 — PBR 권장 (OOS 폴드 전부 양수)

# ── 전략 2: 모멘텀 + 저변동성 (bias-free) ⭐ ──
#USE_MULTI_FACTOR=false
#USE_MOMENTUM=true
#MOMENTUM_WINDOW=12
#USE_LOW_VOLATILITY=true

# ── 전략 3: 카스넬슨 가치투자 (DART 재무제표 기반) ──
# 먼저 `uv run python collect_dart_data.py` 로 재무제표 수집 필요
#USE_KATSENELSON=true
#USE_MULTI_FACTOR=false
#USE_MOMENTUM=false
#USE_LOW_VOLATILITY=true   # 저변동성 결합 시 MDD 크게 개선 (권장)
#MIN_ROIC=0.05          # ROIC 하한 (기본 0.10, 0.05는 실험용 완화값)
#MAX_DEBT_EQUITY=1.5    # 차입금/자본 비율 상한 (기본 1.5)
#MIN_INTEREST_COVERAGE=2.0  # 이자보상배율 하한 (기본 2.0)
#MAX_EV_EBITDA=15.0     # EV/EBITDA 상한 (기본 20.0, 15.0은 실험용 엄격값)
#KATSENELSON_USE_GROWTH=false  # 3Y CAGR 성장 스코어 (기본 off, 데이터상 부정적)
#KATSENELSON_USE_NCAV=false    # NCAV 스코어 (기본 off, Graham net-net)
